# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/talentbridge?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# --- AI provider (Job Parser / CV Extractor / Explanation services) ---
# "agentrouter" (default) uses AGENTROUTER_API_KEY/AGENTROUTER_MODEL — $200 free
# credit across 30+ providers on signup, generally much less rate-limited
# than OpenRouter's free tier.
# "openai" uses OPENAI_API_KEY/OPENAI_MODEL below.
# "deepseek" uses DEEPSEEK_API_KEY/DEEPSEEK_MODEL — DeepSeek's API is
# OpenAI-compatible, so this is the only line you need to change to switch.
# "openrouter" uses OPENROUTER_API_KEY/OPENROUTER_MODEL — gives access to
# free (:free) models, no credit card required, but tightly rate-limited
# (~20 req/min, 50-1,000 req/day).
# All four can also be switched live from the Super Admin "AI provider"
# settings page at /admin instead of editing this file. IMPORTANT: settings
# saved from that page live in the database and OVERRIDE everything here —
# if a change to this file seems to have no effect, check /admin first.
AI_PROVIDER="agentrouter"

# --- OpenAI (ChatGPT API) --- used when AI_PROVIDER=openai
OPENAI_API_KEY="sk-..."
# gpt-4o-mini is the default if unset — extraction/parsing/explanation are
# structured, low-reasoning tasks that don't need a frontier model, and this
# keeps API cost/quota usage far lower. Override to gpt-4o only if you need
# better recall on messy/unusual CVs and have quota to spare.
OPENAI_MODEL="gpt-4o-mini"

# --- DeepSeek --- used when AI_PROVIDER=deepseek
# Get a key from https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- OpenRouter (free-tier option) --- used when AI_PROVIDER=openrouter
# Get a key from https://openrouter.ai/keys — no credit card required.
# z-ai/glm-5.2:free is the default: one of the few free (:free) models on
# OpenRouter that actually enforces structured JSON output via
# response_format, which every AI call in this app depends on. Most other
# :free models either ignore response_format or follow it loosely.
# Free-model limits: ~20 requests/minute, and 50/day (or 1,000/day once
# you've ever bought $10+ in OpenRouter credits) — fine for development and
# demos, but expect to hit these limits on a large bulk CV upload. The app's
# retry/backoff (lib/openai.ts) handles the resulting 429s gracefully rather
# than failing the batch outright.
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="z-ai/glm-5.2:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- AgentRouter (default provider; free-credit option, less rate-limited
# than OpenRouter's free tier) --- used when AI_PROVIDER=agentrouter
# Non-profit unified gateway to 30+ providers (OpenAI, Anthropic, DeepSeek,
# Zhipu AI, and more) behind a single OpenAI-compatible API. New accounts get
# $200 in free credits, no card required.
# Register: https://agentrouter.org/register?aff=mXmd
# Get your key from the dashboard: https://agentrouter.org/console/token
#
# AGENTROUTER_MODEL must be an exact model ID from your AgentRouter catalog
# (see it with: curl -H "Authorization: Bearer $AGENTROUTER_API_KEY" \
#   -H "User-Agent: claude-cli/1.0.0 (external, cli)" \
#   https://agentrouter.org/v1/models).
# Verified working for this app: "gpt-5.6-sol" (default) and "claude-opus-5".
# Do NOT use "glm-5.3" or "deepseek-v4-flash" — they are reasoning-only models
# that spend the entire max_tokens budget on internal reasoning and return an
# empty `content`, which none of this app's JSON services can use.
AGENTROUTER_API_KEY="sk-..."
AGENTROUTER_MODEL="gpt-5.6-sol"
# The /v1 suffix is required: the openai SDK appends /chat/completions to this
# value, and "https://agentrouter.org" alone resolves to a URL that returns
# AgentRouter's HTML console page with HTTP 200 instead of an API response.
# (lib/ai-settings.ts normalises this defensively, but set it correctly here.)
AGENTROUTER_BASE_URL="https://agentrouter.org/v1"
# Optional. AgentRouter allowlists client User-Agents and rejects unknown ones
# with "401 unauthorized client detected" before it checks the API key — the
# openai SDK's own UA is not on that list, so the app sends this instead.
# Only set this if AgentRouter changes its allowlist and the default stops working.
# AGENTROUTER_USER_AGENT="claude-cli/1.0.0 (external, cli)"

# --- DropAphi (file storage + OTP) ---
# Used for both CV/document uploads (POST /files/upload) and the sign-in
# code flow (POST /otp/send, /otp/verify, /otp/resend). One API key covers both.
DROPAPHI_API_KEY="da_live_your_key"
DROPAPHI_BASE_URL="https://dropaphi.xyz/api/v1"
